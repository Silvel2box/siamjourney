# Copy to .env and fill in. Local dev uses XAMPP MySQL; Plesk uses its own DB.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/siamjourney"

# Merchant email to promote to admin via `npx prisma db seed` (see prisma/seed.mjs).
ADMIN_EMAIL="you@example.com"

# Verification mail (lib/email.ts). Leave both empty and the site still works —
# registration goes through and the link is written to the log instead of sent.
# The domain must be verified at Resend before mail leaves.
RESEND_API_KEY=""
EMAIL_FROM="SiamJourney <noreply@siam-journey.com>"
